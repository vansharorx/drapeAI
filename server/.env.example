# Copy this file to server/.env. Never commit the copied file or paste its values into chat.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://drapeai:change-me@127.0.0.1:5432/drapeai
# Generate a unique value of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:8081
UPLOAD_DIR=private-uploads
MAX_UPLOAD_BYTES=10485760

# Optional. Leave blank to keep AI garment recognition disabled.
# Create a key in OpenRouter and never commit or share it.
OPENROUTER_API_KEY=
# The free router selects an available no-cost vision-capable model; its limits and selected model can change.
OPENROUTER_MODEL=openrouter/free
